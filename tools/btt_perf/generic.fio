[global]
filename=/dev/pmem0s
bs=1m
ioengine=sync
iodepth=2
direct=1
norandommap
time_based=1
runtime=30
group_reporting
disable_lat=1
disable_slat=1
disable_clat=1
clat_percentiles=0
numjobs=32
unlink=1
#verify=crc32-intel
#verify_fatal=1
#verify_async=4

[mixed]
rw=randrw
#write_bw_log=seqread
stonewall

[write]
rw=randwrite
#write_bw_log=seqread
stonewall

[read]
rw=randread
#write_bw_log=seqread
stonewall
